#include "..\Headers\BFW_Resources.hpp"



#include "..\Headers\BFW_WinTargetVer.hpp"
#include <Windows.h>



LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US



VS_VERSION_INFO VERSIONINFO
FILEVERSION BFW_VERSION_LIST
PRODUCTVERSION BFW_VERSION_LIST
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VERSION_INFO_FILE_FLAGS
FILEOS VOS_NT_WINDOWS32
FILETYPE VERSION_INFO_FILE_TYPE
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK L"StringFileInfo"
	BEGIN
		BLOCK L"040904B0"
		BEGIN
			VALUE L"CompanyName", BFW_COMPANY_NAME
			VALUE L"FileDescription", BFW_APP_NAME
			VALUE L"FileVersion", BFW_VERSION_STRING
			VALUE L"InternalName", BFW_FILE_NAME
			VALUE L"LegalCopyright", BFW_COPY_RIGHT_EN_US
			VALUE L"LegalTrademarks", BFW_COMPANY_NAME
			VALUE L"OriginalFilename", BFW_FILE_NAME
			VALUE L"ProductName", BFW_APP_NAME
			VALUE L"ProductVersion", BFW_VERSION_STRING
		END
	END
	BLOCK L"VarFileInfo"
	BEGIN
		VALUE L"Translation" 0x0409, 0x04B0
	END
END

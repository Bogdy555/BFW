#include <BFW_Resources.hpp>
#include "..\Headers\BFW_WINDOWS_Resources.hpp"



#include <BFW_WinTargetVer.hpp>
#include <Windows.h>



LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US



VS_VERSION_INFO VERSIONINFO
FILEVERSION BFW_WINDOWS_VERSION_LIST
PRODUCTVERSION BFW_WINDOWS_VERSION_LIST
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VERSION_INFO_FILE_FLAGS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK L"StringFileInfo"
	BEGIN
		BLOCK L"040904B0"
		BEGIN
			VALUE L"CompanyName", BFW_WINDOWS_COMPANY_NAME
			VALUE L"FileDescription", BFW_WINDOWS_APP_NAME
			VALUE L"FileVersion", BFW_WINDOWS_VERSION_STRING
			VALUE L"InternalName", BFW_WINDOWS_FILE_NAME
			VALUE L"LegalCopyright", BFW_WINDOWS_COPY_RIGHT_EN_US
			VALUE L"LegalTrademarks", BFW_WINDOWS_COMPANY_NAME
			VALUE L"OriginalFilename", BFW_WINDOWS_FILE_NAME
			VALUE L"ProductName", BFW_WINDOWS_APP_NAME
			VALUE L"ProductVersion", BFW_WINDOWS_VERSION_STRING
		END
	END
	BLOCK L"VarFileInfo"
	BEGIN
		VALUE L"Translation" 0x0409, 0x04B0
	END
END
